<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.7.0" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.7.0" GeneratePathProperty="true" />
    <!--
      Exact pin, not a floor: Microsoft.OpenApi.YamlReader 3.7.0's own nuspec was built/tested
      against SharpYaml 2.1.4 specifically. SharpYaml 3.x is a complete API redesign (breaking,
      not additive) that Microsoft.OpenApi.YamlReader's compiled code can't call into — confirmed
      empirically: bumping to 3.11.0 compiles fine (we never call SharpYaml directly) but silently
      produces zero generated output at runtime. We have no evidence any OTHER 2.x patch is safe
      either, so pin to the one version actually verified rather than floating within 2.x.
    -->
    <PackageReference Include="SharpYaml" Version="[2.1.4]" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atc.CodeGeneration.CSharp\Atc.CodeGeneration.CSharp.csproj" />
  </ItemGroup>

</Project>