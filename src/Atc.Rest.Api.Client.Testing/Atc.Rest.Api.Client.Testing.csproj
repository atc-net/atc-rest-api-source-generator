<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Atc.Rest.Api.Client.Testing</PackageId>
    <Title>Atc REST API Client Testing</Title>
    <Description>Test doubles for exercising clients generated by Atc.Rest.Api.SourceGenerator at the transport seam - a recording HttpMessageHandler, a stub IHttpClientFactory, canned response builders and request assertion helpers.</Description>
    <PackageTags>atc;rest;api;client;testing;test-doubles;httpclient</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

</Project>
