<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one npm workspace every TypeScript gate installs from (test/NodeWorkspace), shared with the SourceGenerator tests as source -->
    <Compile Include="..\NodeWorkspace\NodeWorkspace.cs" Link="Gates\NodeWorkspace.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc.Console.Spectre" Version="4.0.0" />
    <PackageReference Include="Atc.DotNet" Version="4.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atc.Rest.Api.Generator.Cli\Atc.Rest.Api.Generator.Cli.csproj" />
  </ItemGroup>

  <!-- Include scenario YAML files as content (from subdirectories) -->
  <ItemGroup>
    <Content Include="..\Scenarios\**\*.yaml" CopyToOutputDirectory="PreserveNewest" LinkBase="Scenarios" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>