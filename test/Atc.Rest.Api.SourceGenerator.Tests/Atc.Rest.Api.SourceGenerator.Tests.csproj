<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Enable assembly probing in application directory -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- NOTE: Microsoft.AspNetCore.OpenApi cannot be referenced here. It requires
         Microsoft.OpenApi >= 2.12.0 && < 3.0.0, while this repo pins 3.7.0 (NU1107). That is why
         HttpQueryRuntimeTests covers the Kestrel/QUERY behaviour but not what the runtime OpenAPI
         document contains. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Property-based tests of the escapers and sanitisers: any string, not a handful of odd ones -->
    <PackageReference Include="CsCheck" Version="4.9.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <!-- The scenario snapshots moved here from the integration-test project, so that they are
         produced by the real Roslyn generators rather than a parallel orchestration. -->
    <!-- Pinned to 32.x: Verify 33 fails every Release build until the project declares a sponsorship license (SponsorCheck SC021) -->
    <PackageReference Include="Verify.XunitV3" Version="[32.0.0,33.0.0)" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.10.2" />
    <!-- Same purpose: the resilience/retry scenarios emit code against Polly, so those assemblies
         must be present in the test host for the compilation gate to resolve them. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <!-- Likewise for the OpenID Connect security scenario, whose emitted authentication wiring
         lives outside the ASP.NET Core shared framework. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <!-- The generated scope and role policies against real signed JWTs, as an identity provider issues them -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- The SDK's trim and AOT analyzer, for the AOT gate over the generated code: only its DLL is copied to the
         output, so it does not analyze this project -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_NET_ILLink_Tasks)\analyzers\dotnet\cs\ILLink.RoslynAnalyzer.dll" Link="ILLinkAnalyzer\ILLink.RoslynAnalyzer.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Atc.Rest.MinimalApi is present in the test host, but the harness hides it from a scenario unless
         that scenario's Server marker sets a MinimalApi mode to "Enabled" - otherwise every "Auto"
         scenario would silently switch to the package-backed output. -->
    <PackageReference Include="Atc.Rest.MinimalApi" Version="3.0.0" />
    <!-- Referenced so the assemblies are present in the test host (TRUSTED_PLATFORM_ASSEMBLIES), enabling real C#
         compilation and runs of generated client output (CompilationVerificationTests, the error-body matrix).
         2.6.0: streamed responses read by the library (StreamFraming) and its default registrations, on the trim- and Native AOT-ready (URL-encoded form fields, a body with its own media type, repeated
         multipart fields, a multipart field sent as a JSON part), and query parameter keys are URI-escaped. -->
    <PackageReference Include="Atc.Rest.Client" Version="2.6.0" />
  </ItemGroup>

  <!-- ASP.NET Core shared framework, so generated server/client output (which uses
       Microsoft.AspNetCore.*, Microsoft.Extensions.DependencyInjection/Http) can be compiled in tests. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one npm workspace every runtime matrix installs from (test/NodeWorkspace), shared with the CLI tests as source -->
    <Compile Include="..\NodeWorkspace\NodeWorkspace.cs" Link="Generators\NodeWorkspace.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct reference to Generator for testing its types (CasingHelper, OpenApiDocumentValidator, etc.) -->
    <ProjectReference Include="..\..\src\Atc.Rest.Api.Generator\Atc.Rest.Api.Generator.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- Reference to SourceGenerator for testing its extractors -->
    <!-- OutputItemType="" prevents analyzer treatment -->
    <ProjectReference Include="..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <!-- The end-to-end error-body tests run the CLI executable to generate the TypeScript clients; the fuzz test runs
         the TypeScript generation service in-process over every mutant. -->
    <ProjectReference Include="..\..\src\Atc.Rest.Api.Generator.Cli\Atc.Rest.Api.Generator.Cli.csproj" />
  </ItemGroup>

  <!-- Include runtime assemblies so they are properly registered in deps.json -->
  <Target Name="IncludeRuntimeAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="Atc.Rest.Api.Generator">
        <HintPath>..\..\src\Atc.Rest.Api.Generator\bin\$(Configuration)\netstandard2.0\Atc.Rest.Api.Generator.dll</HintPath>
        <Private>true</Private>
      </Reference>
      <Reference Include="Atc.Rest.Api.SourceGenerator">
        <HintPath>..\..\src\Atc.Rest.Api.SourceGenerator\bin\$(Configuration)\netstandard2.0\Atc.Rest.Api.SourceGenerator.dll</HintPath>
        <Private>true</Private>
      </Reference>
      <Reference Include="Atc.OpenApi">
        <HintPath>..\..\src\Atc.OpenApi\bin\$(Configuration)\netstandard2.0\Atc.OpenApi.dll</HintPath>
        <Private>true</Private>
      </Reference>
      <Reference Include="Atc.CodeGeneration.CSharp">
        <HintPath>..\..\src\Atc.CodeGeneration.CSharp\bin\$(Configuration)\netstandard2.0\Atc.CodeGeneration.CSharp.dll</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>