<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BenchmarkDotNet needs an optimized, non-debug build and loads the generators as plain assemblies -->
    <Optimize>true</Optimize>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generators run in-process through a CSharpGeneratorDriver, so they are referenced as assemblies, not analyzers;
         the generator library is referenced directly because the generator project only packs it -->
    <ProjectReference Include="..\..\src\Atc.Rest.Api.Generator\Atc.Rest.Api.Generator.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- The server and domain generators require ASP.NET Core in the compilation they generate for -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\sample\Showcase\Showcase.yaml" Link="Specs\Showcase.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sample\PetStoreFull\PetStoreFull.yaml" Link="Specs\PetStoreFull.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
