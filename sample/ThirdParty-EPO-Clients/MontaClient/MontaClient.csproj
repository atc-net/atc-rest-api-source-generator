<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MontaPartner.ApiClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI Specification -->
    <AdditionalFiles Include="Monta.yaml" />
    <AdditionalFiles Include="Monta.overlay.yaml" />
    <AdditionalFiles Include=".atc-rest-api-client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source Generator Reference -->
    <ProjectReference Include="..\..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for EndpointPerOperation mode -->
    <!-- TEMP (3.0 development): direct reference to the unreleased trim- and Native AOT-ready atc-rest-client.
         Replace with the released PackageReference before release. -->
    <ProjectReference Include="..\..\..\..\atc-rest-client\src\Atc.Rest.Client\Atc.Rest.Client.csproj" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

</Project>