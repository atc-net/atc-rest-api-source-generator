<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EloverblikThirdPartyApiClientApp</RootNamespace>
    <AssemblyName>EloverblikThirdPartyApiClient-App</AssemblyName>
    <!-- Console demo: literal strings are intentional and not localized. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      EndpointPerOperation mode resolves the endpoints through dependency injection,
      so the app needs the generic host plus IHttpClientFactory.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated client library (generationMode: EndpointPerOperation) -->
    <ProjectReference Include="..\EloverblikThirdPartyApiClient\EloverblikThirdPartyApiClient.csproj" />
  </ItemGroup>

</Project>
