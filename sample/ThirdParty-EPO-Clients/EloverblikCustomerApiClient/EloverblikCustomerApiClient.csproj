<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      ATC_API_SCH021: 'api-1.yaml' is a vendored third-party specification that defines its own
      'ProblemDetails' schema. EndpointPerOperation mode supplies the built-in equivalent, so the
      spec-defined one is ignored. The spec is not ours to change, hence the suppression.
    -->
    <NoWarn>$(NoWarn);ATC_API_SCH021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI Specification -->
    <AdditionalFiles Include="api-1.yaml" />
    <AdditionalFiles Include=".atc-rest-api-client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source Generator Reference -->
    <ProjectReference Include="..\..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for EndpointPerOperation mode -->
    <PackageReference Include="Atc.Rest.Client" Version="2.0.36" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

</Project>