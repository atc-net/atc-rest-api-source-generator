# Analyzer relaxations for unit-test projects living under sample/.
# Mirrors test/.editorconfig, since that file is not inherited from here.

[*.{cs,csx,cake}]

# Meziantou
dotnet_diagnostic.MA0004.severity = none            # Use Task.ConfigureAwait(false)
dotnet_diagnostic.MA0016.severity = none            # Prefer return collection abstraction over implementation
dotnet_diagnostic.MA0051.severity = none            # Method Length

# Microsoft - Code Analysis
dotnet_diagnostic.CA1068.severity = none            # CancellationToken parameters must come last
dotnet_diagnostic.CA1602.severity = none
dotnet_diagnostic.CA1707.severity = none            # Identifiers should not contain underscores
dotnet_diagnostic.CA2007.severity = none            # Do not directly await a Task
dotnet_diagnostic.CA2025.severity = none            # Ensure tasks using 'IDisposable' instances complete before the instances are disposed

# StyleCop
dotnet_diagnostic.SA1122.severity = none            # Use string.Empty for empty strings
dotnet_diagnostic.SA1133.severity = none            # Do not combine attributes

# Custom
dotnet_diagnostic.CA2000.severity = none            # Test doubles (handlers/clients) intentionally outlive the scope
dotnet_diagnostic.ATC201.severity = none            # Single parameter on its own line is the convention here
dotnet_diagnostic.SA1518.severity = none            # File may not end with a newline character
dotnet_diagnostic.xUnit1051.severity = none         # NSubstitute Received(...) argument matchers are not real calls
dotnet_diagnostic.SA1025.severity = none            # Code should not contain multiple whitespace characters in a row
dotnet_diagnostic.S3220.severity = none             # Review this call, which partially matches an overload without 'params'
dotnet_diagnostic.AsyncFixer02.severity = none      # Blocking calls inside async methods
