@page "/testing/exceptions"

<PageTitle>Exception Testing</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Exception Testing</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Test different exceptions and their HTTP status code mappings from GlobalErrorHandlingMiddleware.
</MudText>

<MudGrid>
    @foreach (var test in ExceptionTests)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Class="mb-2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1">Code @test.Code</MudText>
                        <MudText Typo="Typo.caption">@test.ExceptionType</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudChip T="string" Color="@GetExpectedStatusColor(test.ExpectedStatus)" Size="Size.Small">
                            @test.ExpectedStatus
                        </MudChip>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-2">@test.Description</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="() => RunTestAsync(test.Code)"
                               Disabled="isLoading">
                        @if (isLoading && currentTestCode == test.Code)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Test
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<MudDivider Class="my-4" />

<MudText Typo="Typo.h5" Class="mb-4">Test Results</MudText>

<MudTable Items="testResults" Hover="true" Striped="true" Dense="true">
    <HeaderContent>
        <MudTh>Time</MudTh>
        <MudTh>Code</MudTh>
        <MudTh>Exception Type</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Expected</MudTh>
        <MudTh>Match</MudTh>
        <MudTh>Message</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Time">@context.Timestamp.ToString("HH:mm:ss")</MudTd>
        <MudTd DataLabel="Code">@context.Code</MudTd>
        <MudTd DataLabel="Exception">@context.ExceptionType</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.ActualStatus)" Size="Size.Small">
                @context.ActualStatus
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Expected">@context.ExpectedStatus</MudTd>
        <MudTd DataLabel="Match">
            @if (context.StatusMatched)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
            }
        </MudTd>
        <MudTd DataLabel="Message">
            <MudText Typo="Typo.caption" Style="max-width: 300px; overflow: hidden; text-overflow: ellipsis;">
                @context.Message
            </MudText>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No tests run yet. Click a "Test" button above to test exception handling.</MudText>
    </NoRecordsContent>
</MudTable>

<MudButton Variant="Variant.Outlined"
           Color="Color.Secondary"
           Class="mt-4"
           OnClick="RunAllTestsAsync"
           Disabled="isLoading">
    @if (isLoading && currentTestCode == -1)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
    }
    Run All Tests
</MudButton>

<MudButton Variant="Variant.Text"
           Color="Color.Default"
           Class="mt-4 ml-2"
           OnClick="ClearResults"
           Disabled="isLoading">
    Clear Results
</MudButton>

<MudDivider Class="my-6" />

<MudText Typo="Typo.h4" Class="mb-2">Error Responses</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Errors a handler returns on purpose (<code>NotFound("…")</code>, <code>Conflict("…")</code>, …). The specification declares
    no body for them, so each one arrives as an RFC 9457 ProblemDetails (<code>application/problem+json</code>), and the
    generated client's typed accessors return it parsed - the handler's message is the <code>detail</code>.
</MudText>

<MudStack Row="true" Class="mb-4">
    @foreach (var status in ErrorStatuses)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="() => RunErrorResponseTestAsync(status)"
                   Disabled="isLoading">
            @status
        </MudButton>
    }
</MudStack>

<MudTable Items="errorResponseResults" Hover="true" Striped="true" Dense="true">
    <HeaderContent>
        <MudTh>Status</MudTh>
        <MudTh>Title</MudTh>
        <MudTh>Detail</MudTh>
        <MudTh>Validation errors</MudTh>
        <MudTh>Retry-After</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
        </MudTd>
        <MudTd DataLabel="Title">@context.Title</MudTd>
        <MudTd DataLabel="Detail">@context.Detail</MudTd>
        <MudTd DataLabel="Validation errors">@context.Errors</MudTd>
        <MudTd DataLabel="Retry-After">@context.RetryAfter</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No error responses requested yet. Click a status above.</MudText>
    </NoRecordsContent>
</MudTable>

<MudText Typo="Typo.h4" Class="mt-8 mb-2">Declared 400 Model</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    This operation declares its own 400 body, <code>TestingProblem</code>, which has no field errors. An invalid request
    body is still rejected by the generated ValidationFilter with a ValidationProblemDetails - the generated client reads
    it as the declared <code>TestingProblem</code> (<code>BadRequestContent</code>) and gives the field errors through
    <code>BadRequestValidationErrors</code>. The name "taken" is rejected by the handler itself, without field errors.
</MudText>

<MudStack Row="true" Class="mb-4">
    @foreach (var request in DeclaredBadRequests)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="() => RunDeclaredBadRequestTestAsync(request)"
                   Disabled="isLoading">
            @request.Label
        </MudButton>
    }
</MudStack>

<MudTable Items="declaredBadRequestResults" Hover="true" Striped="true" Dense="true" Class="declared-bad-request-results">
    <HeaderContent>
        <MudTh>Request</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Title</MudTh>
        <MudTh>Detail</MudTh>
        <MudTh>BadRequestValidationErrors</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Request">@context.Request</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.Result.Status)" Size="Size.Small">@context.Result.Status</MudChip>
        </MudTd>
        <MudTd DataLabel="Title">@context.Result.Title</MudTd>
        <MudTd DataLabel="Detail">@context.Result.Detail</MudTd>
        <MudTd DataLabel="BadRequestValidationErrors">@(context.Result.ValidationErrors ?? "(none)")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No requests sent yet. Click a request above.</MudText>
    </NoRecordsContent>
</MudTable>