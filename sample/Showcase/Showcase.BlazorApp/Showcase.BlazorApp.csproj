<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="3.0.174" />
    <PackageReference Include="Atc.Rest.Client" Version="2.0.36" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Showcase.yaml" />
    <AdditionalFiles Include=".atc-rest-api-client" />
  </ItemGroup>

  <!--
    Razor.globalconfig: glob-based EditorConfig sections ([*.razor], [*.{cs,csx,cake}])
    never match the synthetic paths of syntax trees emitted by the Razor source
    generator, so severities that must reach Razor-generated @code blocks (e.g. S8969/
    S8970 for CascadingParameter's required null! initializer) need an unconditional
    (is_global = true) config file instead.
  -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="Razor.globalconfig" />
  </ItemGroup>

</Project>