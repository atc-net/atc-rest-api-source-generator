<MudCard Elevation="2" Class="mt-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Import users as XML</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            A list of users as one XML document, written by the generated <code>CreateUserRequestXml.ListToXml</code>.
            <code>POST /users/import</code> takes the list as JSON or XML: the generated server binds it by its
            Content-Type, and the validation filter checks every user - make a first name one letter long to see it.
        </MudText>
        <textarea @bind="xml" @bind:event="oninput" rows="12" spellcheck="false" data-testid="users-import-xml"
                  style="width: 100%; font-family: monospace; font-size: 0.8rem;"></textarea>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="isImporting"
                   OnClick="ImportAsync" data-testid="users-import">Import</MudButton>
        @if (status is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-2" data-testid="users-import-status">@status</MudText>
        }

        @foreach (var user in imported)
        {
            <MudText Typo="Typo.body2" data-testid="users-import-row">@user</MudText>
        }
    </MudCardContent>
</MudCard>