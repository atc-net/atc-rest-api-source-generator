<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Atc.Rest.MinimalApi from source when the atc-rest-minimalapi repository is checked out next to this one
         (a change there is built and tested here); the package otherwise -->
    <PackageReference Include="Atc.Rest.MinimalApi" Version="3.1.0" Condition="!Exists('$(MSBuildThisFileDirectory)../../../../atc-rest-minimalapi/src/Atc.Rest.MinimalApi/Atc.Rest.MinimalApi.csproj')" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../../../atc-rest-minimalapi/src/Atc.Rest.MinimalApi/Atc.Rest.MinimalApi.csproj" Condition="Exists('$(MSBuildThisFileDirectory)../../../../atc-rest-minimalapi/src/Atc.Rest.MinimalApi/Atc.Rest.MinimalApi.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Showcase.yaml" />
    <AdditionalFiles Include=".atc-rest-api-server" />
  </ItemGroup>

</Project>
