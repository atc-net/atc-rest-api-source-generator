<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      MultipartDemo.yaml is an OpenAPI 3.1 document that deliberately keeps the legacy `nullable: true`
      spelling, so that the samples between them cover both forms - Showcase.yaml demonstrates the 3.2
      `type: [x, "null"]` form. ATC_API_VER002 correctly points out that 3.1 removed the keyword; here
      that is the point of the sample, so the rule is suppressed rather than obeyed.
    -->
    <NoWarn>$(NoWarn);ATC_API_VER002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc.Rest.MinimalApi" Version="2.0.41" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Atc.Rest.Api.SourceGenerator\Atc.Rest.Api.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\MultipartDemo.yaml" />
    <AdditionalFiles Include=".atc-rest-api-server" />
  </ItemGroup>

</Project>